{
  // Built like `../../../declarations-sound`, in partial mode, with one
  // difference: it emits declaration files, because the fixtures that depend
  // on it compile against them, the way a library compiles against an
  // installed dependency.
  "extends": "../../../../../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts"],
  // The root config excludes every fixture, and `exclude` is inherited.
  "exclude": [],
  "angularCompilerOptions": {
    "compilationMode": "partial",
    "strictTemplates": true
  }
}
