{
  // Built like `../cdk`, but in FULL mode, the form an application build
  // emits: each definition is a `ɵɵdefineDirective` call the runtime reads
  // directly, and there is no partial declaration for the check to read.
  "extends": "../../../../../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts"],
  // The root config excludes every fixture, and `exclude` is inherited.
  "exclude": [],
  "angularCompilerOptions": {
    "compilationMode": "full",
    "strictTemplates": true
  }
}
