node_modules/
# Except the one the declaration fixtures find their dependency in, the way
# Node would: what it holds is committed source, built like theirs.
!/src/node/fixtures/node_modules/
# And the dependencies the entry-point fixtures carry: `unloadableEntryPoints`
# imports those packages for real, so each sits beside the install it would
# have, and these are part of the fixture rather than of anybody's install.
!src/node/fixtures/entry-points-*/node_modules/
/dist/
coverage/

# VitePress build output and cache. `docs/api/` is NOT here: the generated API
# reference is committed on purpose, so a pull request shows what a change did
# to the public surface, and `docs:check` fails when the commit is stale.
docs/.vitepress/dist/
docs/.vitepress/cache/

.DS_Store
*.log

# Emitted by `npm run fixtures` (ngc). Compiled test fixtures, never shipped.
.fixtures/
# The partial-mode builds of the declaration fixtures, compiled on every test
# run so the check reads what the installed compiler emits rather than a copy.
src/node/fixtures/declarations-*/dist/
src/node/fixtures/node_modules/**/dist/
src/node/fixtures/entry-points-sound/dist/
src/node/fixtures/entry-points-broken/dist/
